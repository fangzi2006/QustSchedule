<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_next_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_next_label"
        android:scaleType="fitXY"
        android:src="@drawable/widget_preview_card" />

    <LinearLayout
        android:id="@+id/widget_next_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_next_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_ongoing_light"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="正在上课"
                android:textColor="#FF0F766E"
                android:textSize="9.5dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_date_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:textColor="#FF5F6775"
                android:textSize="9.5dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_next_bar"
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:layout_marginTop="1.5dp"
                android:layout_marginBottom="1.5dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_bar_pill" />

            <TextView
                android:id="@+id/widget_next_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="2"
                android:paddingStart="7dp"
                android:text="单片机原理及应用A"
                android:textColor="#FF1A1D24"
                android:textSize="14dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="10:25-12:00"
            android:textColor="#FF3F5AA6"
            android:textSize="12dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.5dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="M1-215 · 王老师"
            android:textColor="#FF5F6775"
            android:textSize="10.5dp" />
    </LinearLayout>
</FrameLayout>
