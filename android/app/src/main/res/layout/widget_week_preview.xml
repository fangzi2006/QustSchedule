<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第 1 周"
                android:textColor="#FF3F5AA6"
                android:textSize="11dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="9/7–9/13"
                android:textColor="#FF5F6775"
                android:textSize="9.2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="一"
                android:textColor="#FF5F6775"
                android:textSize="9dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="二"
                android:textColor="#FF5F6775"
                android:textSize="9dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_accent_light"
                android:gravity="center"
                android:text="三"
                android:textColor="#FF3F5AA6"
                android:textSize="9dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="四"
                android:textColor="#FF5F6775"
                android:textSize="9dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="五"
                android:textColor="#FF5F6775"
                android:textSize="9dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_accent_light"
                android:gravity="center"
                android:padding="4dp"
                android:text="传感器与检测\nM1-115"
                android:textColor="#FF0C447C"
                android:textSize="8.5dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_ongoing_light"
                android:gravity="center"
                android:padding="4dp"
                android:text="自动控制原理\nM1-204"
                android:textColor="#FF085041"
                android:textSize="8.5dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_tomorrow_light"
                android:gravity="center"
                android:padding="4dp"
                android:text="单片机原理\nM1-215"
                android:textColor="#FF3C3489"
                android:textSize="8.5dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_exam_light"
                android:gravity="center"
                android:padding="4dp"
                android:text="电力电子技术\nM1-237"
                android:textColor="#FF633806"
                android:textSize="8.5dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_reschedule_light"
                android:gravity="center"
                android:padding="4dp"
                android:text="信号与系统\nM1-308"
                android:textColor="#FF0369A1"
                android:textSize="8.5dp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
