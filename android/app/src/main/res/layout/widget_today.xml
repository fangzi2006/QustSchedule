<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_today_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_today_label"
        android:scaleType="fitXY"
        android:src="@drawable/widget_preview_card" />

    <LinearLayout
        android:id="@+id/widget_today_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="11.5dp"
        android:paddingTop="10dp"
        android:paddingEnd="11.5dp"
        android:paddingBottom="1dp">

        <LinearLayout
            android:id="@+id/widget_today_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_today_header_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_pill_bg"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="5dp"
                android:paddingTop="1.5dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1.5dp"
                android:textSize="9dp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_today_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="第1周 周一"
                android:textColor="#FF3F5AA6"
                android:textSize="11.5dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_today_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="青科课表通"
                android:textColor="#FF5F6775"
                android:textSize="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_today_compact_cue_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_today_compact_cue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_bg"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:textSize="8.5dp"
                android:textStyle="bold" />
        </LinearLayout>

        <ListView
            android:id="@+id/widget_today_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/widget_today_empty_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_today_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="3"
                android:textColor="#FF5F6775"
                android:textSize="11.5dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_today_exam_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/widget_today_exam_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_exam_card_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/widget_today_exam_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFE65100"
                    android:textSize="9.5dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_today_exam_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FF1A1D24"
                    android:textSize="12.5dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_today_exam_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FF5F6775"
                    android:textSize="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
