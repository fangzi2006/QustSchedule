<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_week_card_r20" />

    <LinearLayout
        android:id="@+id/widget_week_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="8dp"
        android:paddingEnd="9dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/widget_week_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_week_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="第 1 周"
                android:textColor="#FF3F5AA6"
                android:textSize="11dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_week_range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:textColor="#FF5F6775"
                android:textSize="9.2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_weekdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="2.5dp">

            <TextView
                android:id="@+id/widget_week_axis_spacer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minWidth="18dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="12"
                android:textSize="8dp"
                android:visibility="invisible" />

            <FrameLayout
                android:id="@+id/widget_week_day_box_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_week_day_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="5.5dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="5.5dp"
                    android:paddingBottom="1.5dp"
                    android:text="一"
                    android:textColor="#FF5F6775"
                    android:textSize="8.8dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_week_day_box_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_week_day_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="5.5dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="5.5dp"
                    android:paddingBottom="1.5dp"
                    android:text="二"
                    android:textColor="#FF5F6775"
                    android:textSize="8.8dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_week_day_box_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_week_day_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="5.5dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="5.5dp"
                    android:paddingBottom="1.5dp"
                    android:text="三"
                    android:textColor="#FF5F6775"
                    android:textSize="8.8dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_week_day_box_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_week_day_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="5.5dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="5.5dp"
                    android:paddingBottom="1.5dp"
                    android:text="四"
                    android:textColor="#FF5F6775"
                    android:textSize="8.8dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_week_day_box_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_week_day_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="5.5dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="5.5dp"
                    android:paddingBottom="1.5dp"
                    android:text="五"
                    android:textColor="#FF5F6775"
                    android:textSize="8.8dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_week_day_box_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_week_day_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="5.5dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="5.5dp"
                    android:paddingBottom="1.5dp"
                    android:text="六"
                    android:textColor="#FF5F6775"
                    android:textSize="8.8dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_week_day_box_7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_week_day_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="5.5dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="5.5dp"
                    android:paddingBottom="1.5dp"
                    android:text="日"
                    android:textColor="#FF5F6775"
                    android:textSize="8.8dp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_grid_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_week_axis_col"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/widget_week_col_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/widget_week_col_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/widget_week_col_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/widget_week_col_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/widget_week_col_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/widget_week_col_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/widget_week_col_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_empty_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_week_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="#FF1A1D24"
                android:textSize="12dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_week_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="#FF5F6775"
                android:textSize="10.5dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
