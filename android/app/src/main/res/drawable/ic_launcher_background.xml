<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的背景：与矢量图的蓝色渐变一致（左上 -> 右下）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#1A7CF3"
        android:endColor="#3F5AE5"
        android:startColor="#0498FF"
        android:type="linear" />
</shape>
