<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份规则：同样排除 sharedpref（安全存储所在处）。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
